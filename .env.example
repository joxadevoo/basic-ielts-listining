VITE_MEDIA_BASE_URL=https://3rdqnprfkrc5djuh.public.blob.vercel-storage.com

# Server-only Telegram config (set in Vercel Environment Variables — never use VITE_ prefix)
# Support multiple chat IDs separated by commas.
# Example: TELEGRAM_CHAT_ID=user_id,group_id
TELEGRAM_CHAT_ID=your_group_id_here
TELEGRAM_BOT_TOKEN=your_bot_token_here

# /api/log security (optional)
APP_URL=https://fluentear.vercel.app
ALLOWED_ORIGINS=https://fluentear.vercel.app,http://localhost:3000,http://127.0.0.1:3000
LOG_RATE_LIMIT_PER_HOUR=60
LOG_SESSION_START_LIMIT_PER_HOUR=10

# Private stats storage (Vercel Blob — create store in Vercel dashboard)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# --- Reading question generation (server-only — never use VITE_ prefix) ---
# OpenAI generates IELTS questions; results are cached in Supabase so each unique
# passage costs tokens at most once.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
SUPABASE_URL=https://your-project.supabase.co
# service_role key (Supabase dashboard → Settings → API). Bypasses RLS for cache writes.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here